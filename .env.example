# 로컬 개발용 값입니다. 이 파일을 .env 로 복사하면 바로 실행됩니다.
# 운영에서는 비밀번호와 JWT_SECRET 을 반드시 새 값으로 바꾸세요. .env 는 커밋되지 않습니다.
NODE_ENV=development
PORT=3000
TZ=UTC

# DATABASE_URL 의 비밀번호와 포트는 아래 POSTGRES_PASSWORD, POSTGRES_PORT 와 같아야 합니다.
DATABASE_URL=postgres://app:local-dev-password@localhost:5433/gbexp
DATABASE_SSL=false
DATABASE_SSL_CA=
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5433

# 32바이트 이상이어야 합니다.
JWT_SECRET=local-dev-secret-change-me-before-deploy-0000
JWT_TTL_DAYS=30

# 프런트엔드 개발 서버의 주소입니다. 여러 개면 쉼표로 구분합니다.
CORS_ORIGIN=http://localhost:5173

THROTTLE_PER_USER_PER_MINUTE=120
THROTTLE_CREATE_USER_PER_IP_PER_HOUR=10
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
STATIC_ROOT=./static
PUBLIC_BASE_URL=http://localhost:3000
