# 환경 변수 목록입니다. 비밀 값은 이 파일에 적지 않습니다.
# 로컬 개발은 npm run setup:env 를 실행하면 .env 가 만들어지고 비밀 값이 무작위로 채워집니다.
# .env 는 커밋되지 않습니다.
NODE_ENV=development
PORT=3000
TZ=UTC

# 형식: postgres://app:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/gbexp
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# 32바이트 이상의 무작위 값
JWT_SECRET=
JWT_TTL_DAYS=30

# 프런트엔드 개발 서버의 주소입니다. 여러 개면 쉼표로 구분합니다.
CORS_ORIGIN=http://localhost:5173

THROTTLE_PER_USER_PER_MINUTE=120
THROTTLE_CREATE_USER_PER_IP_PER_HOUR=10
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
STATIC_ROOT=./static
PUBLIC_BASE_URL=http://localhost:3000

# 챗봇용 선택 값입니다. 비어 있으면 시세 수집과 AI 문장 생성을 하지 않고 정형 답변만 합니다.
DATA_GO_KR_SERVICE_KEY=
# AI 문장 다듬기. AI_API_KEY 는 Gemini 키이며, 있으면 CLOVA 대신 사용합니다.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
CLOVA_API_KEY=
CLOVA_MODEL=HCX-005
